# Скопіюйте цей файл у .env і впишіть свої значення
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ваш_пароль
DB_NAME=db

# Довгий випадковий рядок, напр.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=замініть_на_випадковий_рядок

# На macOS/Linux зазвичай python3, на Windows — python
PYTHON_BIN=python3
